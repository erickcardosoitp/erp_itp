{
  "title": "ITP — Banco de Dados (detalhado)",
  "uid": "itp-banco-dados",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["itp"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Conexões ativas (limite: 100)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 36, "titleSize": 14 } }
    },
    {
      "id": 2, "type": "stat", "title": "Tamanho do banco",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "pg_database_size_bytes{datname=\"erp_itp_db\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "decbytes",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 30, "titleSize": 14 } }
    },
    {
      "id": 3, "type": "stat", "title": "Taxa de acerto do cache (quanto maior, melhor)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read)) * 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 90 }, { "color": "green", "value": 98 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 30, "titleSize": 14 } }
    },
    {
      "id": 4, "type": "stat", "title": "Travamentos (locks) agora",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "sum(pg_locks_count)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 50 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 30, "titleSize": 14 } }
    },

    {
      "id": 5, "type": "timeseries", "title": "Conexões ativas ao longo do tempo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "sum(pg_stat_database_numbackends)", "refId": "A", "legendFormat": "Conexões" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Transações por segundo (confirmadas x desfeitas)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [
        { "expr": "sum(rate(pg_stat_database_xact_commit[5m]))", "refId": "A", "legendFormat": "Confirmadas (commit)" },
        { "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))", "refId": "B", "legendFormat": "Desfeitas (rollback)" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    {
      "id": 7, "type": "bargauge", "title": "Maiores tabelas (tamanho)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "topk(10, pg_stat_user_tables_table_size_bytes)", "refId": "A", "legendFormat": "{{relname}}" }],
      "fieldConfig": { "defaults": { "unit": "decbytes", "min": 0,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal",
        "displayMode": "gradient", "showUnfilled": true, "text": { "valueSize": 14 } }
    },
    {
      "id": 8, "type": "bargauge", "title": "Linhas \"mortas\" por tabela (precisam de limpeza/vacuum)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "topk(10, pg_stat_user_tables_n_dead_tup)", "refId": "A", "legendFormat": "{{relname}}" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 10000 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal",
        "displayMode": "gradient", "showUnfilled": true, "text": { "valueSize": 14 } }
    }
  ]
}
