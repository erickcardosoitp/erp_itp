{
  "title": "KPI BUSINESS - APRXM",
  "uid": "aprxm-kpi-business",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["aprxm"],
  "panels": [
    { "id": 100, "type": "row", "title": "🚨 Indicadores críticos", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 1, "type": "stat", "title": "Mensalidades vencidas",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "aprxm_mensalidades_vencidas", "refId": "A", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 60 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 40, "titleSize": 16 } }
    },
