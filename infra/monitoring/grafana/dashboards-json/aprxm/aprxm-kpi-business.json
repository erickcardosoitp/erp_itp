      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "aprxm_receita_hoje_reais", "refId": "A", "legendFormat": "Receita" }],
      "fieldConfig": { "defaults": { "unit": "currencyBRL", "min": 0,
