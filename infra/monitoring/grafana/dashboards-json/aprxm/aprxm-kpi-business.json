    {
      "id": 4, "type": "timeseries", "title": "Moradores cadastrados — últimas 24h",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "aprxm_moradores_cadastrados_hoje", "refId": "A", "legendFormat": "Cadastros" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 101, "type": "row", "title": "📦 Encomendas e Ordens de Serviço", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "collapsed": false },

