{
  "title": "APRXM — Performance (Apdex e Latência)",
  "uid": "aprxm-performance",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["aprxm"],
  "panels": [
    { "id": 100, "type": "row", "title": "🎯 Apdex (T=0.5s)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 1, "type": "stat", "title": "Apdex score (última 1h)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "(sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"0.5\"}[1h])) + (sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"2\"}[1h])) - sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"0.5\"}[1h]))) / 2) / sum(rate(aprxm_http_request_duration_seconds_count[1h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.94 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 40, "titleSize": 16 } }
    },
    {
      "id": 2, "type": "stat", "title": "Tempo médio de resposta (1h)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "sum(rate(aprxm_http_request_duration_seconds_sum[1h])) / sum(rate(aprxm_http_request_duration_seconds_count[1h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1.5 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 36, "titleSize": 16 } }
    },
    {
      "id": 3, "type": "stat", "title": "p95 (1h)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(aprxm_http_request_duration_seconds_bucket[1h])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 36, "titleSize": 16 } }
    },
    {
      "id": 4, "type": "stat", "title": "Taxa de erro 5xx (1h)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "(sum(rate(aprxm_http_requests_total{status_code=~\"5..\"}[1h])) or vector(0)) / (sum(rate(aprxm_http_requests_total[1h])) or vector(1)) * 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 36, "titleSize": 16 } }
    },

    { "id": 101, "type": "row", "title": "📈 Tendência", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "collapsed": false },

    {
      "id": 5, "type": "timeseries", "title": "Apdex ao longo do tempo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "(sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"0.5\"}[10m])) + (sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"2\"}[10m])) - sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"0.5\"}[10m]))) / 2) / sum(rate(aprxm_http_request_duration_seconds_count[10m]))", "refId": "A", "legendFormat": "Apdex" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1,
        "custom": { "lineWidth": 2, "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Latência p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(aprxm_http_request_duration_seconds_bucket[10m])))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(aprxm_http_request_duration_seconds_bucket[10m])))", "refId": "B", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(aprxm_http_request_duration_seconds_bucket[10m])))", "refId": "C", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },

    { "id": 102, "type": "row", "title": "🔥 Pontos críticos", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "collapsed": false },

    {
      "id": 7, "type": "table", "title": "Rotas mais lentas (p95, última 1h)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, route) (rate(aprxm_http_request_duration_seconds_bucket[1h]))))", "refId": "A", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }
        ] } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "le": true },
          "indexByName": {},
          "renameByName": { "method": "Método", "route": "Rota", "Value": "p95 (s)" }
        } }
      ]
    },
    {
      "id": 8, "type": "table", "title": "Rotas com mais erro (5xx, última 1h)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "topk(10, sum by (method, route, status_code) (increase(aprxm_http_requests_total{status_code=~\"5..\"}[1h])))", "refId": "A", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }
        ] } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true },
          "indexByName": {},
          "renameByName": { "method": "Método", "route": "Rota", "status_code": "Status", "Value": "Erros (1h)" }
        } }
      ]
    },

    {
      "id": 9, "type": "table", "title": "Rotas mais chamadas (volume, última 1h)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "topk(15, sum by (method, route) (increase(aprxm_http_requests_total[1h])))", "refId": "A", "format": "table", "instant": true }],
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true },
          "indexByName": {},
          "renameByName": { "method": "Método", "route": "Rota", "Value": "Chamadas (1h)" }
        } }
      ]
    }
  ]
}
