{
  "title": "KPI BUSINESS - ITP",
  "uid": "itp-kpi-business",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["itp"],
  "panels": [
    { "id": 100, "type": "row", "title": "🎓 Acadêmico", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 1, "type": "stat", "title": "Alunos ativos",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "itp_alunos_ativos", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 40, "titleSize": 16 } }
    },
    {
      "id": 2, "type": "stat", "title": "Matrículas concluídas hoje",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "itp_matriculas_hoje", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none",
        "text": { "valueSize": 40, "titleSize": 16 } }
    },
    {
