{
  "title": "Sistemas e Aplicações",
  "uid": "sistemas-e-aplicacoes",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["itp", "aprxm", "geral"],
  "panels": [
    { "id": 100, "type": "row", "title": "🌐 Disponibilidade — todos os sistemas", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    {
      "id": 1, "type": "stat", "title": "Sistema ITP",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 }, "timeFrom": "5m",
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "probe_success{instance=\"https://itp.institutotiapretinha.org\"}", "refId": "A" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "FORA DO AR", "color": "red" }, "1": { "text": "NO AR", "color": "green" }
        } }],
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none", "text": { "valueSize": 24, "titleSize": 14 } }
    },
