      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "increase(aprxm_receita_reais_total[$__range])", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "currencyBRL",
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none", "text": { "valueSize": 32, "titleSize": 14 } }
