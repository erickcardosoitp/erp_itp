    { "id": 104, "type": "row", "title": "🎯 Apdex e erros — lado a lado", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 }, "collapsed": false },

    {
      "id": 15, "type": "stat", "title": "ITP — Taxa de erro 5xx (5m)",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "(sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) or vector(0)) / (sum(rate(http_requests_total[5m])) or vector(1)) * 100", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none", "text": { "valueSize": 32, "titleSize": 14 } }
    },
    {
      "id": 16, "type": "stat", "title": "APRXM — Apdex score (1h)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus_itp" },
      "targets": [{ "expr": "(sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"0.5\"}[1h])) + (sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"2\"}[1h])) - sum(rate(aprxm_http_request_duration_seconds_bucket{le=\"0.5\"}[1h]))) / 2) / sum(rate(aprxm_http_request_duration_seconds_count[1h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.94 }
        ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "textMode": "value", "colorMode": "background", "graphMode": "none", "text": { "valueSize": 32, "titleSize": 14 } }
